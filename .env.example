# Copy to .env and fill in QLOO_API_KEY. Never commit .env.
# No key? Leave it empty: the app runs in replay mode and serves only cached/snapshot data.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# live | record | replay   (replay = cache + snapshot only, no network, no key needed)
QLOO_MODE=live
# Ops master switch. false = no Qloo calls of any kind (results come back as served_from=disabled).
QLOO_ENABLED=true

# Budgets (live HTTP requests to Qloo, retries included)
QLOO_MAX_LIVE_CALLS=600
QLOO_DAILY_LIVE_CAP=500
QLOO_CLIENT_HOURLY_CAP=60
QLOO_RUN_CAP=150
QLOO_DEMO_RESERVE=100
QLOO_RPS=2

# Cache
QLOO_CACHE_PATH=data/qloo_cache.sqlite
QLOO_CACHE_TTL_DAYS=7

# Service
# Salt for hashing requester IPs into client ids. Set a long random string in production.
IP_HASH_SALT=
# Comma-separated list of origins allowed by CORS. Empty = no cross-origin access.
ALLOWED_ORIGINS=
