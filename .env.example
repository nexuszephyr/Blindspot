# Copy to .env and fill in QLOO_API_KEY. Never commit .env.
# No key? Leave it empty: the app runs in replay mode and serves only cached/snapshot data.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# live | record | replay   (replay = cache + snapshot only, no network, no key needed)
QLOO_MODE=live
# Ops master switch. false = no Qloo calls of any kind (results come back as served_from=disabled).
QLOO_ENABLED=true

# Budgets (live HTTP requests to Qloo, retries included)
QLOO_MAX_LIVE_CALLS=600
QLOO_DAILY_LIVE_CAP=500
QLOO_CLIENT_HOURLY_CAP=60
QLOO_RUN_CAP=150
QLOO_DEMO_RESERVE=100
QLOO_RPS=4

# Cache
QLOO_CACHE_PATH=data/qloo_cache.sqlite
QLOO_CACHE_TTL_DAYS=7

# Service
# Salt for hashing requester IPs into client ids. Set a long random string in production.
IP_HASH_SALT=
# Comma-separated list of origins allowed by CORS. Empty = no cross-origin access.
ALLOWED_ORIGINS=
# Overall deadline (seconds) for one web request, retries included.
REQUEST_DEADLINE_S=8

# Target models (#11). Never commit values.
GROQ_API_KEY=        # console.groq.com; free tier; used by gpt-oss-20b (live), gpt-oss-120b, qwen-27b
GEMINI_API_KEY=      # aistudio.google.com; free tier; gemini-flash (precomputed only)
# Public endpoints, not secrets (OpenAI-compatible base URLs).
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Cache of target answers (#27); a repeated prompt makes no model call.
TARGET_CACHE_PATH=data/targets.sqlite
